# ---------------------------------------------------------------
# PrivacyGuard AI — environment template. Copy to `.env` and fill in.
# Never commit `.env`.
# ---------------------------------------------------------------

# --- LLM provider (OpenAI-compatible endpoint) ---
# Option A: Google Gemini (cloud, OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash

# Option B: Mistral (cloud)
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=your-mistral-api-key-here
# LLM_MODEL=mistral-small-latest

# Option C: Ollama (local) — any non-empty API key works
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Option D: LM Studio (local)
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=local-model

# --- Agent loop ---
MAX_STEPS=25
LLM_MAX_RETRIES=5
# Leave empty for automatic: 60 s for cloud, 300 s for local models (first call loads the model)
LLM_TIMEOUT_S=

# --- OCR ---
# Full path to tesseract.exe (leave empty if it is on PATH)
TESSERACT_CMD=D:\Tesseract\tesseract.exe
OCR_LANGS=ron+eng

# --- Vault / privacy ---
# Optional fixed HMAC secret (hex). Leave empty to generate a fresh random
# secret per server session (recommended: hashes cannot be correlated across sessions).
VAULT_SECRET=

# --- Output ---
# Leave empty to use <project>/output
OUTPUT_DIR=

# --- Optional local SLM for name/address NER (used by detect_pii(use_local_slm=True)) ---
LOCAL_SLM_BASE_URL=http://localhost:11434/v1
LOCAL_SLM_MODEL=qwen2.5:3b

# --- Text-to-speech ---
TTS_ENABLED=true
# Optional path to piper executable + voice model (fallback when pyttsx3 is unavailable)
PIPER_EXE=
PIPER_VOICE=

# --- Web UI login (python -m ui.api) — change for anything beyond local dev ---
UI_USERNAME=admin
UI_PASSPHRASE=privacyguard
# Optional: where folders are stored (default ./workspace_folders)
UI_WORKSPACE=

# --- Redaction style: blur (noise + pixelation + Gaussian, default) or black (solid boxes) ---
REDACTION_MODE=blur

# Blur strength itself is chosen per call / per folder (low|medium|high|maximum or 1..10, default high).

# --- Redaction margin: max(min px, ratio x box height), capped at 1.5% of the image long side ---
REDACTION_PADDING_RATIO=0.25
REDACTION_MIN_PADDING_PX=4
# --- Face detection (OpenCV YuNet model in models/) ---
FACE_MODEL_PATH=
FACE_SCORE_THRESHOLD=0.6
FACE_PADDING_RATIO=0.3

# --- Adaptive detection ---
# Rules learned from manual blur boxes (labels + value shapes only). Default: <project>/learned_rules.json
LEARNED_RULES_PATH=
# Flatten photographed pages (4-corner perspective warp) before deskew / OCR
DEWARP_ENABLED=true
# Second OCR pass for Cyrillic / foreign documents (only when cues appear); "+ukr" is added automatically if installed
OCR_LANGS_FOREIGN=ron+eng+rus

# --- Form auto-fill: TrueType font with Romanian diacritics (ăâîșț). Empty = DejaVu/Liberation/Arial/Segoe UI ---
FORM_FONT_PATH=
